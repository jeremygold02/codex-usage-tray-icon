<UserControl x:Class="CodexUsageTray.WpfSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Background="{DynamicResource ScreenBackground}" Foreground="{DynamicResource PrimaryText}"
    FontFamily="Segoe UI" FontSize="16" TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries><ui:ThemesDictionary Theme="Dark"/><ui:ControlsDictionary/></ResourceDictionary.MergedDictionaries>
        <SolidColorBrush x:Key="CardBackground" Color="#1D2329"/>
        <SolidColorBrush x:Key="CardBorder" Color="#47515C"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#CFD2D8"/>
        <SolidColorBrush x:Key="IconBlue" Color="#68B9F8"/>
        <SolidColorBrush x:Key="ScreenBackground" Color="#14191F"/>
        <SolidColorBrush x:Key="SideBackground" Color="#151A20"/>
        <SolidColorBrush x:Key="SideBorder" Color="#38404A"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#F5F6F7"/>
        <SolidColorBrush x:Key="TileBackground" Color="#26394B"/>
        <SolidColorBrush x:Key="NavSelected" Color="#1F4163"/>
        <SolidColorBrush x:Key="NavHover" Color="#222A33"/>
        <SolidColorBrush x:Key="ControlOutline" Color="#858D96"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#232A31"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#323B44"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOn" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPointerOver" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ToggleSwitchKnobFillOnPressed" Color="#FFFFFF"/>
        <Style x:Key="SettingCard" TargetType="{x:Type ui:Card}">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="24,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ui:Card}">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,3,12,0"/>
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="48"/><Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="11"/><Setter Property="Background" Value="{DynamicResource TileBackground}"/>
            <Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="0,0,20,0"/>
        </Style>
        <Style x:Key="TileIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="FontSize" Value="27"/><Setter Property="Foreground" Value="{DynamicResource IconBlue}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="NavigationItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="BackgroundBorder" Background="Transparent" CornerRadius="7">
                            <Grid>
                                <Border x:Name="Accent" Width="5" CornerRadius="2" Background="Transparent" HorizontalAlignment="Left"/>
                                <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource NavSelected}"/>
                                <Setter TargetName="Accent" Property="Background" Value="#168EFA"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="IsSelected" Value="False"/></MultiTrigger.Conditions>
                                <Setter TargetName="BackgroundBorder" Property="Background" Value="{DynamicResource NavHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavIcon" TargetType="{x:Type ui:SymbolIcon}">
            <Setter Property="FontSize" Value="23"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Width" Value="28"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CardNumber" TargetType="{x:Type ui:NumberBox}" BasedOn="{StaticResource {x:Type ui:NumberBox}}">
            <Setter Property="Width" Value="96"/><Setter Property="Height" Value="35"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="MaxDecimalPlaces" Value="0"/>
            <Setter Property="SpinButtonPlacementMode" Value="Compact"/><Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Ellipse x:Name="Ring" Width="18" Height="18" Stroke="{DynamicResource ControlOutline}" StrokeThickness="1"/>
                    <Ellipse x:Name="Dot" Width="8" Height="8" Fill="White" Visibility="Collapsed"/>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="Fill" Value="#0078D7"/><Setter TargetName="Ring" Property="Stroke" Value="#168EFA"/><Setter TargetName="Dot" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="StrokeThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Grid Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border x:Name="Box" Width="18" Height="18" BorderBrush="{DynamicResource ControlOutline}" BorderThickness="1" CornerRadius="3">
                        <Path x:Name="Mark" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/>
                    </Border>
                    <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#0078D7"/><Setter TargetName="Box" Property="BorderBrush" Value="#168EFA"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemBackground" Background="Transparent" Padding="{TemplateBinding Padding}">
                    <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource NavHover}"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBackground" Property="Background" Value="{DynamicResource NavSelected}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ControlOutline}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="MinHeight" Value="39"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="DropBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"/>
                    <ToggleButton x:Name="DropButton" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent"/>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter IsHitTestVisible="False" Margin="12,0,35,0" VerticalAlignment="Center"
                                      Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                      TextElement.Foreground="{TemplateBinding Foreground}"/>
                    <Path IsHitTestVisible="False" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                    <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                        <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0" Background="{DynamicResource CardBackground}" BorderBrush="{DynamicResource ControlOutline}" BorderThickness="1" CornerRadius="5">
                            <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="DropBorder" Property="BorderBrush" Value="#168EFA"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="{x:Type ui:Button}">
            <Setter Property="FontSize" Value="16"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="{x:Type ui:Button}">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" TextElement.Foreground="{TemplateBinding Foreground}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#168EFA"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#168EFA"/><Setter TargetName="ButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ForecastSegment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="FontSize" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="SegmentBorder" CornerRadius="8" Background="Transparent" Padding="12,8">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="SegmentBorder" Property="Background" Value="#0078D7"/><Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SegmentBorder" Property="BorderBrush" Value="#FFFFFF"/><Setter TargetName="SegmentBorder" Property="BorderThickness" Value="1"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
      </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="0"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Grid.Row="1" Background="{DynamicResource ScreenBackground}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource SideBackground}" BorderBrush="{DynamicResource SideBorder}" BorderThickness="0,0,1,0">
                <ListBox x:Name="Navigation" Background="Transparent" BorderThickness="0" Margin="13,24,10,0"
                         ItemContainerStyle="{StaticResource NavigationItem}" SelectionChanged="Navigation_SelectionChanged"
                         AutomationProperties.Name="Settings categories">
                    <ListBoxItem Tag="General"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" Style="{StaticResource NavIcon}"/><TextBlock Text="General" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Usage" IsSelected="True"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DataHistogram24" Style="{StaticResource NavIcon}"/><TextBlock Text="Usage &amp; alerts" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Forecast"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DataTrending24" Style="{StaticResource NavIcon}"/><TextBlock Text="Forecast &amp; graphs" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Appearance"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Color24" Style="{StaticResource NavIcon}"/><TextBlock Text="Appearance" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Popup"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Chat24" Style="{StaticResource NavIcon}"/><TextBlock Text="Popup" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                    <ListBoxItem Tag="Updates"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowClockwise24" Style="{StaticResource NavIcon}"/><TextBlock Text="Updates" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></ListBoxItem>
                </ListBox>
            </Border>
            <Grid Grid.Column="1" Margin="32,27,24,22">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock x:Name="PageTitle" Text="Usage &amp; alerts" FontSize="33" FontWeight="Bold"/>
                    <TextBlock x:Name="PageDescription" Text="Control how usage is shown in the tray and when you’re notified."
                               Foreground="{DynamicResource TextSecondary}" FontSize="18" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,2,0">
                    <Grid>
                        <StackPanel x:Name="UsagePanel">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="92">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="2*"/><ColumnDefinition Width="2.1*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tray icon display" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose how the tray icon shows your usage." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <RadioButton x:Name="MetricWeekly" Content="Weekly" GroupName="Metric" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="MetricFiveHour" Content="5-hour" GroupName="Metric" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <RadioButton x:Name="MetricAuto" Content="Auto" GroupName="Metric" IsChecked="True" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                </Grid>
                            </ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="108">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Alert24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Usage threshold alerts" Style="{StaticResource CardTitle}"/><TextBlock Text="Get alerted when usage reaches these levels." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <CheckBox x:Name="ThresholdAlerts" Content="Enable usage threshold alerts" AutomationProperties.Name="Enable usage threshold alerts"/>
                                        <WrapPanel Margin="18,12,0,0" IsEnabled="{Binding IsChecked, ElementName=ThresholdAlerts}">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,25,0"><TextBlock Text="Critical" VerticalAlignment="Center" Margin="0,0,12,0"/><ui:NumberBox x:Name="CriticalValue" Value="15" Minimum="1" Maximum="99" Style="{StaticResource CardNumber}" AutomationProperties.Name="Critical threshold percent"/><TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                                            <StackPanel Orientation="Horizontal"><TextBlock Text="Low" VerticalAlignment="Center" Margin="0,0,12,0"/><ui:NumberBox x:Name="LowValue" Value="25" Minimum="1" Maximum="99" Style="{StaticResource CardNumber}" AutomationProperties.Name="Low threshold percent"/><TextBlock Text="%" VerticalAlignment="Center" Margin="8,0,0,0"/></StackPanel>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="104">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowClockwise24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Reset expiry reminders" Style="{StaticResource CardTitle}"/><TextBlock Text="Get a reminder before a reset credit expires." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <CheckBox x:Name="ReminderEnabled" Content="Reset expiry reminders" IsChecked="True"/>
                                        <WrapPanel Margin="18,12,0,0" IsEnabled="{Binding IsChecked, ElementName=ReminderEnabled}"><ui:NumberBox x:Name="ReminderHours" Value="24" Minimum="1" Maximum="72" Style="{StaticResource CardNumber}" AutomationProperties.Name="Reminder hours before expiry"/><TextBlock Text="hours before expiry" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="108">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Clock24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Auto-use resets" Style="{StaticResource CardTitle}"/><TextBlock Text="Use an expiring reset credit when there is usage to reset." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <CheckBox x:Name="AutoUseEnabled" Content="Auto-use resets"/>
                                        <WrapPanel Margin="18,12,0,0" IsEnabled="{Binding IsChecked, ElementName=AutoUseEnabled}"><TextBlock Text="Lead time" VerticalAlignment="Center" Margin="0,0,16,0"/><ui:NumberBox x:Name="AutoUseMinutes" Value="5" Minimum="1" Maximum="120" Style="{StaticResource CardNumber}" AutomationProperties.Name="Auto-use lead time in minutes"/><TextBlock Text="minutes" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </StackPanel>
                        <StackPanel x:Name="ForecastPanel" Visibility="Collapsed">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="108">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="DataHistogram24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Forecast method" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose how future usage is estimated." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <Border Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12,0,0,0" BorderBrush="{DynamicResource ControlOutline}" BorderThickness="1" CornerRadius="10" Padding="3">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <RadioButton x:Name="ForecastLearned" Content="Learned routine" GroupName="ForecastMethod" IsChecked="True" Style="{StaticResource ForecastSegment}"/>
                                            <RadioButton x:Name="ForecastRecent" Grid.Column="1" Content="Recent pace" GroupName="ForecastMethod" Style="{StaticResource ForecastSegment}"/>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="104">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="CalendarEmpty24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Quiet hours" Style="{StaticResource CardTitle}"/><TextBlock Text="Use recurring quiet periods in weekly projections." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <ComboBox x:Name="QuietHours" Grid.Column="2" Width="310" MaxWidth="310" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" AutomationProperties.Name="Quiet hours mode"><ComboBoxItem Content="Learn automatically"/><ComboBoxItem Content="Off"/></ComboBox>
                                </Grid>
                            </ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="120">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.2*"/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="DataTrending24" Style="{StaticResource TileIcon}"/></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Graph display" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose what to show in usage graphs." Style="{StaticResource CardDescription}"/></StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="16,0,0,0">
                                        <Grid Margin="0,0,0,12"><TextBlock Text="Show projected usage" VerticalAlignment="Center"/><ui:ToggleSwitch x:Name="ShowProjection" HorizontalAlignment="Right" IsChecked="True" OnContent="" OffContent="" AutomationProperties.Name="Show projected usage"/></Grid>
                                        <Grid><TextBlock Text="Highlight quiet hours" VerticalAlignment="Center"/><ui:ToggleSwitch x:Name="HighlightQuiet" HorizontalAlignment="Right" IsChecked="True" OnContent="" OffContent="" AutomationProperties.Name="Highlight quiet hours"/></Grid>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                            <StackPanel Orientation="Horizontal" Margin="0,36,0,0"><ui:SymbolIcon Symbol="Info24" Foreground="{DynamicResource TextSecondary}" FontSize="21"/><TextBlock Text="These are estimates, not guarantees." Margin="10,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="GeneralPanel" Visibility="Collapsed">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Clock24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Refresh while Codex is running" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose how often to update usage." Style="{StaticResource CardDescription}"/></StackPanel><WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:NumberBox x:Name="RunningRefresh" Value="300" Minimum="30" Maximum="3600" Style="{StaticResource CardNumber}" AutomationProperties.Name="Running refresh seconds"/><TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Clock24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Refresh while Codex is closed" Style="{StaticResource CardTitle}"/><TextBlock Text="Zero pauses automatic refresh while idle." Style="{StaticResource CardDescription}"/></StackPanel><WrapPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"><ui:NumberBox x:Name="IdleRefresh" Value="0" Minimum="0" Maximum="7200" Style="{StaticResource CardNumber}" AutomationProperties.Name="Idle refresh seconds"/><TextBlock Text="seconds" VerticalAlignment="Center" Margin="10,0,0,0"/></WrapPanel></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowClockwise24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Startup" Style="{StaticResource CardTitle}"/><TextBlock Text="Open the app automatically when you sign in." Style="{StaticResource CardDescription}"/></StackPanel><ui:ToggleSwitch x:Name="StartWithWindows" Grid.Column="2" Content="Start with Windows" HorizontalAlignment="Right" VerticalAlignment="Center" OnContent="" OffContent=""/></Grid></ui:Card>
                        </StackPanel>
                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Color24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Theme" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose the app’s color scheme." Style="{StaticResource CardDescription}"/></StackPanel><ComboBox x:Name="ThemeChoice" Grid.Column="2" Width="240" HorizontalAlignment="Right" VerticalAlignment="Center" SelectedIndex="0" AutomationProperties.Name="Theme"><ComboBoxItem Content="System default"/><ComboBoxItem Content="Dark mode"/><ComboBoxItem Content="Light mode"/></ComboBox></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="108"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tray background" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose whether to show a background and customize its color." Style="{StaticResource CardDescription}"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><ui:ToggleSwitch x:Name="TrayBackground" Content="Show tray background" IsChecked="True" OnContent="" OffContent=""/><StackPanel Orientation="Horizontal" Margin="0,10,0,0" IsEnabled="{Binding IsChecked, ElementName=TrayBackground}"><ui:Button x:Name="TrayBoxColor" Width="38" Height="32" Click="TrayBoxColor_Click" AutomationProperties.Name="Choose tray background color"/><ui:Button x:Name="TrayBoxAuto" Content="Auto" Padding="14,6" Margin="8,0,0,0" Click="TrayBoxAuto_Click"/><TextBlock x:Name="TrayBoxHex" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></StackPanel></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Color24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tray text color" Style="{StaticResource CardTitle}"/><TextBlock Text="Choose the color used for the tray percentage." Style="{StaticResource CardDescription}"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><ui:Button x:Name="TrayTextColor" Width="38" Height="32" Click="TrayTextColor_Click" AutomationProperties.Name="Choose tray text color"/><TextBlock x:Name="TrayTextHex" VerticalAlignment="Center" Margin="14,0,0,0"/></StackPanel></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Desktop24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Tray preview" Style="{StaticResource CardTitle}"/><TextBlock Text="Preview the icon and check its contrast." Style="{StaticResource CardDescription}"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Image x:Name="TrayPreview" Width="34" Height="34" Stretch="None" AutomationProperties.Name="Live tray preview"/><TextBlock Text="Remaining" VerticalAlignment="Center" Margin="12,0,10,0"/><ui:NumberBox x:Name="PreviewRemaining" Value="50" Minimum="0" Maximum="100" Style="{StaticResource CardNumber}" AutomationProperties.Name="Preview remaining percent"/><TextBlock Text="%" VerticalAlignment="Center" Margin="5,0,0,0"/></StackPanel><TextBlock x:Name="ContrastStatus" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Grid></ui:Card>
                        </StackPanel>
                        <StackPanel x:Name="PopupPanel" Visibility="Collapsed">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Clock24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Updated time" Style="{StaticResource CardTitle}"/><TextBlock Text="Show when usage was last refreshed." Style="{StaticResource CardDescription}"/></StackPanel><ui:ToggleSwitch x:Name="ShowUpdatedTime" Grid.Column="2" Content="Show updated time" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="Calendar24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Reset times" Style="{StaticResource CardTitle}"/><TextBlock Text="Show when each usage limit resets." Style="{StaticResource CardDescription}"/></StackPanel><ui:ToggleSwitch x:Name="ShowResetTimes" Grid.Column="2" Content="Show reset times" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></ui:Card>
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="98"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="DataHistogram24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Usage bar colors" Style="{StaticResource CardTitle}"/><TextBlock Text="Use threshold colors for remaining usage." Style="{StaticResource CardDescription}"/></StackPanel><ui:ToggleSwitch x:Name="ColorUsageBars" Grid.Column="2" Content="Color usage bars" IsChecked="True" OnContent="" OffContent="" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid></ui:Card>
                        </StackPanel>
                        <StackPanel x:Name="UpdatesPanel" Visibility="Collapsed">
                            <ui:Card Style="{StaticResource SettingCard}" MinHeight="105"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><Border Style="{StaticResource IconTile}"><ui:SymbolIcon Symbol="ArrowClockwise24" Style="{StaticResource TileIcon}"/></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Application updates" Style="{StaticResource CardTitle}"/><TextBlock Text="Check the installed version and look for updates." Style="{StaticResource CardDescription}"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock x:Name="VersionText" Margin="0,0,0,10"/><TextBlock x:Name="UpdateStatus" TextWrapping="Wrap" Margin="0,0,0,10"/><ui:Button x:Name="CheckUpdates" Content="Check updates" Click="CheckUpdates_Click"/></StackPanel></Grid></ui:Card>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
                <Grid Grid.Row="2" Margin="0,20,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="1"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="{DynamicResource CardBorder}"/>
                    <Grid Grid.Row="1" Margin="0,26,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <ui:Button x:Name="RestoreDefaultsButton" Content="Restore defaults" Padding="20,10" Click="RestoreDefaults_Click" AutomationProperties.Name="Restore all default settings"/>
                        <StackPanel Grid.Column="2" Orientation="Horizontal"><ui:Button Content="Cancel" Padding="28,10" Margin="0,0,16,0" Click="Cancel_Click"/><ui:Button Padding="30,10" Appearance="Primary" Background="#0078D7" Foreground="White" Click="Save_Click" AutomationProperties.Name="Save settings"><TextBlock Text="Save" Foreground="White"/></ui:Button></StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
