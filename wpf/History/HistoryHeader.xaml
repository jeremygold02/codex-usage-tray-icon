<UserControl x:Class="CodexUsageTray.HistoryHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    FontFamily="Segoe UI" Foreground="{DynamicResource HistoryForeground}" Background="{DynamicResource HistoryBackground}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="HistoryBackground" Color="#13181F"/>
        <SolidColorBrush x:Key="HistoryForeground" Color="#F4F6F8"/>
        <SolidColorBrush x:Key="HistorySegmentBackground" Color="#1F2630"/>
        <SolidColorBrush x:Key="HistorySegmentBorder" Color="#53606F"/>
        <SolidColorBrush x:Key="HistorySelectedBackground" Color="#0069BE"/>
        <SolidColorBrush x:Key="HistorySelectedForeground" Color="White"/>
        <SolidColorBrush x:Key="HistoryAccent" Color="#57B9F7"/>
        <SolidColorBrush x:Key="HistoryForecastAccent" Color="#F2B24D"/>
        <Style x:Key="HistoryPeriodButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource HistoryForeground}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="Segment" CornerRadius="6" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource HistorySelectedBackground}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource HistoryAccent}"/><Setter Property="Foreground" Value="{DynamicResource HistorySelectedForeground}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource HistoryForeground}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource HistoryBackground}">
        <Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="PeriodGroup" Width="250" Height="40" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource HistorySegmentBackground}" BorderBrush="{DynamicResource HistorySegmentBorder}" BorderThickness="1" CornerRadius="7">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition x:Name="FiveHourColumn"/></Grid.ColumnDefinitions>
                <RadioButton x:Name="Weekly" Content="_Weekly" IsChecked="True" Style="{StaticResource HistoryPeriodButton}" Checked="PeriodChecked" AutomationProperties.Name="Weekly limit: history since the latest reset"/>
                <RadioButton x:Name="FiveHour" Grid.Column="1" Content="_5-hour" Style="{StaticResource HistoryPeriodButton}" Checked="PeriodChecked" AutomationProperties.Name="Five-hour limit: history since the latest reset"/>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="4,8,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="20*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="34*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="46*"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="4,0,8,0">
                <TextBlock Text="Remaining" FontSize="14"/>
                <TextBlock x:Name="Remaining" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Remaining"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{DynamicResource HistorySegmentBorder}" Margin="0,6"/>
            <Grid Grid.Column="2" Margin="14,0,8,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="CalendarEmpty24" FontSize="25" Foreground="{DynamicResource HistoryAccent}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"><TextBlock Text="Next reset" FontSize="13"/><TextBlock x:Name="Reset" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Next reset"/></StackPanel>
            </Grid>
            <Border Grid.Column="3" Background="{DynamicResource HistorySegmentBorder}" Margin="0,6"/>
            <Grid Grid.Column="4" Margin="14,0,0,0" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="DataTrending24" FontSize="25" Foreground="{DynamicResource HistoryForecastAccent}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1"><TextBlock Text="Forecast" FontSize="13"/><TextBlock x:Name="Forecast" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.Name="Forecast"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
